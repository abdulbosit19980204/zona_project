# Backend muhit o'zgaruvchilari. Serverda: /etc/zona/zona.env  (install.sh o'zi yaratadi va kalitlarni generatsiya qiladi)
# Fayl huquqi: 640, egasi root:zona — sirlar bor, boshqalar o'qimasin.

DJANGO_DEBUG=0
# Uzun tasodifiy qator. O'zgarsa, foydalanuvchilar qayta kiradi (parollar saqlanadi).
DJANGO_SECRET_KEY=__GENERATE__
# AI kalitlarini bazada shifrlash kaliti. O'ZGARTIRMANG — o'zgarsa, saqlangan AI kalitlarini qayta kiritish kerak bo'ladi.
ZONA_ENCRYPTION_KEY=__GENERATE__
# Kirish tokenlari (JWT) imzosi. Mikroservislar (QR Drive) tokenni shu kalit bilan o'zlari tekshiradi —
# /etc/zona/qrdrive.env dagi QRDRIVE_SSO_SECRET bilan bir xil bo'lishi shart (qrdrive-setup.sh o'zi yozadi).
ZONA_JWT_SECRET=__GENERATE__

# Domen yoki server IP (vergul bilan). Masalan: zona.stargroup.uz,10.0.0.5
DJANGO_ALLOWED_HOSTS=__DOMAIN__,127.0.0.1,localhost
# Brauzer manzili (sxema bilan). HTTPS bo'lsa https://
DJANGO_CSRF_TRUSTED_ORIGINS=https://__DOMAIN__,http://__DOMAIN__
ZONA_FRONTEND_URL=https://__DOMAIN__
# HTTPS hali sozlanmagan bo'lsa (faqat http://IP orqali) — 0 qiling, aks holda admin panelga kirib bo'lmaydi
DJANGO_SECURE_COOKIES=1

# Ishchi baza — repodan TASHQARIDA (git pull uni hech qachon o'zgartirmaydi)
ZONA_DB_PATH=/var/lib/zona/db.sqlite3

# Telegram bot uchun kalit (POST /api/bot/ask/, X-Bot-Key sarlavhasi). Bo'sh — bot o'chiq.
ZONA_BOT_API_KEY=
# Bepul Gemini kaliti (ixtiyoriy): aistudio.google.com/apikey. Keyin Sozlamalar → AI'da ham kiritsa bo'ladi.
ZONA_GEMINI_API_KEY=

DJANGO_LOG_LEVEL=INFO

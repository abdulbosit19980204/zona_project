# QR Drive mikroservisi muhiti. Serverda: /etc/zona/qrdrive.env (qrdrive-setup.sh o'zi yaratadi).
# Bu yerda faqat ishga tushirish parametrlari. Qolgan BARCHA sozlamalar (bot tokeni, saqlash joylari va parollari,
# sayt manzili, QR dizayni, ...) — panelda: QR Drive → Bot sozlamalari / Saqlash joylari.

QRDRIVE_DEBUG=0
# Bazadagi maxfiy qiymatlarni (bot tokeni, NAS paroli) shifrlash kaliti. O'ZGARTIRMANG va zaxiralab qo'ying.
QRDRIVE_MASTER_KEY=__GENERATE__
# Zona platformasi JWT kaliti (/etc/zona/zona.env dagi ZONA_JWT_SECRET bilan bir xil)
QRDRIVE_SSO_SECRET=__SSO__

QRDRIVE_DATA_DIR=/var/lib/zona/qrdrive
# Zaxira qiymat: panelda «Sayt manzili» bo'sh bo'lsa ishlatiladi (QR Drive → Bot sozlamalari → Umumiy)
QRDRIVE_PUBLIC_BASE_URL=__SCHEME__://__DOMAIN__
QRDRIVE_HOST=127.0.0.1
QRDRIVE_PORT=8100
TZ=Asia/Tashkent
QRDRIVE_LOG_LEVEL=INFO

# Ixtiyoriy. Eski bot .env faylini panelda import qilish qulayroq: QR Drive → Tizim holati → «Eski bot sozlamalarini import qilish»
QRDRIVE_LEGACY_ENV=

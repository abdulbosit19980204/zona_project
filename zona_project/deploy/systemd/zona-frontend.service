[Unit]
Description=Zona frontend (Next.js)
After=network.target zona-backend.service

[Service]
User=zona
Group=zona
WorkingDirectory=/opt/zona/frontend
Environment=NODE_ENV=production
Environment=BACKEND_URL=http://127.0.0.1:8000
ExecStart=/opt/zona/frontend/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

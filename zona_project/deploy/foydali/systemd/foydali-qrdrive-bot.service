[Unit]
Description=Foydali — QR Drive Telegram bot (aiogram)
After=network.target

[Service]
User=foydali
Group=foydali
WorkingDirectory=__SRC__/services/qrdrive
EnvironmentFile=/etc/foydali/foydali-qrdrive.env
ExecStart=__SRC__/services/qrdrive/.venv/bin/python -m qrdrive.bot.main
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/foydali

[Install]
WantedBy=multi-user.target

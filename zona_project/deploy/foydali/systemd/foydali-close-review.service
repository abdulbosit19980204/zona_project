[Unit]
Description=Foydali — support review navbatini haftalik yopish (support_close_review --older-than 7)
After=network.target foydali-backend.service

[Service]
Type=oneshot
User=foydali
Group=foydali
WorkingDirectory=__SRC__/backend
EnvironmentFile=/etc/foydali/foydali.env
ExecStart=__SRC__/.venv/bin/python manage.py support_close_review --older-than 7 --ids-file /var/lib/foydali/backups/review_rejected_ids_{date}.txt
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/foydali

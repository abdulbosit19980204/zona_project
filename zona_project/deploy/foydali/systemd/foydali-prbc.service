[Unit]
Description=Foydali — PRBC worker (xodimlar sinxronlashi, ishdan bo'shaganlar, vazifalar API orqali)
After=network.target foydali-backend.service foydali-redis.service
Wants=foydali-redis.service

[Service]
User=foydali
Group=foydali
WorkingDirectory=__SRC__/backend
EnvironmentFile=/etc/foydali/foydali.env
ExecStart=__SRC__/.venv/bin/python manage.py prbc_worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/foydali

[Install]
WantedBy=multi-user.target

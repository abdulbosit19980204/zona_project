{
 "mode": "systemd",
 "services": [
  {
   "name": "foydali-backend",
   "label": "Masʼuliyat platformasi — backend",
   "group": "Masʼuliyat platformasi",
   "unit": "foydali-backend",
   "port": 8020,
   "health": "http://127.0.0.1:8020/api/auth/login/"
  },
  {
   "name": "foydali-qrdrive-api",
   "label": "QR Drive — API",
   "group": "QR Drive",
   "unit": "foydali-qrdrive-api",
   "port": 8120,
   "health": "http://127.0.0.1:8120/qrdrive/health",
   "open": "/qrdrive/api/docs"
  },
  {
   "name": "foydali-qrdrive-worker",
   "label": "QR Drive — worker (navbat)",
   "group": "QR Drive",
   "unit": "foydali-qrdrive-worker"
  },
  {
   "name": "foydali-qrdrive-bot",
   "label": "QR Drive — Telegram bot",
   "group": "QR Drive",
   "unit": "foydali-qrdrive-bot"
  },
  {
   "name": "foydali-support-bot",
   "label": "Support bot — Telegram avto-javob",
   "group": "Support bot",
   "unit": "foydali-support-bot"
  },
  {
   "name": "foydali-prbc",
   "label": "PRBC integratsiya (worker)",
   "group": "Masʼuliyat platformasi",
   "unit": "foydali-prbc"
  },
  {
   "name": "foydali-frontend",
   "label": "Panel (Next.js, pm2)",
   "group": "Interfeys",
   "ctl": [
    "/usr/local/sbin/foydali-pm2"
   ],
   "port": 3020,
   "health": "http://127.0.0.1:3020/login",
   "open": "/"
  }
 ],
 "resources": {
  "disk": "/",
  "extra_units": [
   {
    "unit": "biolab",
    "label": "BioLab (bio-lab.uz)",
    "group": "Boshqa loyihalar"
   },
   {
    "unit": "nginx",
    "label": "nginx (veb-server)",
    "group": "Tizim"
   },
   {
    "unit": "foydali-control",
    "label": "Servislar markazi",
    "group": "Tizim"
   },
   {
    "unit": "systemd-journald",
    "label": "Tizim loglari (journald)",
    "group": "Tizim"
   }
  ],
  "paths": [
   {
    "label": "Baza (SQLite)",
    "path": "/var/lib/foydali/db.sqlite3"
   },
   {
    "label": "Baza jurnali (WAL)",
    "path": "/var/lib/foydali/db.sqlite3-wal"
   },
   {
    "label": "Support rasmlari va fayllari",
    "path": "/var/lib/foydali/support-media"
   },
   {
    "label": "QR Drive ma'lumotlari",
    "path": "/var/lib/foydali/qrdrive"
   },
   {
    "label": "Zaxiralar",
    "path": "/var/lib/foydali/backups"
   }
  ]
 },
 "security": {
  "sites": [
   {
    "name": "Foydali (panel)",
    "url": "https://foydali.xisobchim.uz/login",
    "host": "foydali.xisobchim.uz"
   },
   {
    "name": "BioLab",
    "url": "https://bio-lab.uz/",
    "host": "bio-lab.uz"
   }
  ],
  "backups": "/var/lib/foydali/backups",
  "backup_max_hours": 30,
  "log_units": [
   "biolab",
   "biolab-ci",
   "nginx",
   "ssh"
  ]
 }
}
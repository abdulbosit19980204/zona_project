# Nusxa oling: .env.local — va kerak bo'lsa o'zgartiring.

# Next.js serveri /api/* so'rovlarini shu Django manziliga uzatadi (CORS kerak emas).
BACKEND_URL=http://127.0.0.1:8000

# Brauzer API manzili. Odatda o'zgartirilmaydi: "/api" (yuqoridagi proxy orqali).
# NEXT_PUBLIC_API_URL=/api

# WebSocket (jonli yangilanishlar). Bo'sh bo'lsa: ws://<joriy-xost>:8000/ws/events/
# NEXT_PUBLIC_WS_URL=wss://example.com/ws/events/

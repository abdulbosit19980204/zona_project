# Ushbu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env faylini hech kimga yubormang va chatga yozmang.

# --- Telegram ---
BOT_TOKEN=123456789:AA...            # @BotFather bergan token
TELEGRAM_API_ID=1234567              # https://my.telegram.org -> API development tools
TELEGRAM_API_HASH=abcdef0123456789...

# Faylni yuklay oladigan xodimlarning Telegram ID'lari (vergul bilan). Bot'ga /id yozib bilib olinadi.
ALLOWED_USER_IDS=111111111,222222222

# Maksimal fayl hajmi (MB)
MAX_FILE_MB=100

# --- Synology ---
SYNO_URL=https://192.168.1.10:5001   # DSM manzili (QuickConnect emas)
SYNO_USER=qr-bot                     # alohida foydalanuvchi, 2FA o'chirilgan
SYNO_PASS=
SYNO_VERIFY_SSL=false                # NAS'da o'z-o'zidan imzolangan sertifikat bo'lsa false
SYNO_BASE_FOLDER=/Kadrlar            # fayllar shu papka ichida <username>/ ga tushadi

# --- Havola sozlamalari ---
SHARE_EXPIRE_DAYS=0                  # 0 = muddatsiz, masalan 30 = 30 kun
SHARE_PASSWORD=                      # bo'sh = parolsiz
